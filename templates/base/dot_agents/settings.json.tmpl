{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70"
  },
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/statusline.sh"
  },
  "extraKnownMarketplaces": {
    {{#if egress_ok}}"claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    {{/if egress_ok}}"project-init": {
      "source": {
        {{#if project_init_github}}"source": "github", "repo": "{{project_init_repo}}"{{/if project_init_github}}{{#if project_init_enterprise}}"source": "git", "url": "{{project_init_repo_url}}"{{/if project_init_enterprise}}
      }
    }
  },
  "enabledPlugins": {
    {{#if egress_ok}}"security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true{{#if plugin_mode}},
    {{/if plugin_mode}}{{/if egress_ok}}{{#if plugin_mode}}"project-init-workflow@project-init": true{{#if lifecycle}},
    "project-init-lifecycle@project-init": true{{/if lifecycle}}{{/if plugin_mode}}
  }{{#if no_plugin}},
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/session_setup.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/pre_commit_gate.sh",
            "timeout": 60
          },
{{#if lifecycle}}          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/github_command_guard.sh",
            "timeout": 60
          },
{{/if lifecycle}}          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/_py.sh \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/prod_guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/_py.sh \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/package_guard.py",
            "timeout": 15
          }
        ]
      }{{#if lifecycle}},
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/_py.sh \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/pre_edit_issue_guard.py",
            "timeout": 10
          }
        ]
      }{{/if lifecycle}}
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/post_edit_lint.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/_py.sh \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/tool_output_compressor.py",
            "timeout": 10
          }
        ]
      }
    ]{{#if lifecycle}},
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/workflow_state_reminder.sh",
            "timeout": 10
          }
        ]
      }
    ]{{/if lifecycle}}
  }{{/if no_plugin}}
}
