{{#if vscode}}{
  "files.exclude": {
    "**/.DS_Store": true{{#if python}},
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.mypy_cache": true,
    "**/.coverage": true,
    "**/htmlcov": true,
    "**/.venv": true,
    "**/*.egg-info": true{{#if want_docs}},
    "site": true{{/if want_docs}}{{/if python}}{{#if node}},
    "**/node_modules": true,
    "**/dist": true{{#if want_docs}},
    "_site": true{{/if want_docs}}{{/if node}}{{#if go}},
    "bin": true{{/if go}}{{#if rust}},
    "target": true{{/if rust}}{{#if obsidian}},
    ".agents/vault": true{{/if obsidian}}{{#if rag}},
    ".cocoindex_code": true{{/if rag}}{{#if graphify}},
    "graphify-out": true{{/if graphify}}{{#if observability}},
    ".agents/observability/dashboard.html": true,
    ".agents/observability/usage.jsonl": true{{/if observability}},
    ".agents/settings.local.json": true,
    ".agents/scheduled_tasks.lock": true
  },
  "editor.formatOnSave": true{{#if python}},
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  }{{/if python}}{{#if go}},
  "go.formatTool": "gofumpt"{{/if go}}{{#if rust}},
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  }{{/if rust}}
}
{{/if vscode}}