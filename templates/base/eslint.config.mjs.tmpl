{{#if node}}// eslint.config.mjs — quality gates for project code (scaffolded by project-init).
// Install the toolchain once:
//   bun add -d eslint "typescript@^5" typescript-eslint eslint-plugin-jsdoc \
//     eslint-plugin-tsdoc eslint-plugin-security eslint-plugin-no-unsanitized
// typescript@^5: typescript-eslint cannot parse with TS 7 (#732).
// Biome stays formatter-only — it lacks gate-grade complexity/doc rules.
import { dirname } from "node:path";
import { fileURLToPath } from "node:url";
import tseslint from "typescript-eslint";
import jsdoc from "eslint-plugin-jsdoc";
import tsdoc from "eslint-plugin-tsdoc";
import security from "eslint-plugin-security";
import noUnsanitized from "eslint-plugin-no-unsanitized";

// fileURLToPath(import.meta.url), not import.meta.dirname: this config can
// run under plain Node (npx eslint, CI, editor integrations), not just Bun —
// import.meta.dirname needs Node 20.11+ and isn't worth the floor bump.
const __dirname = dirname(fileURLToPath(import.meta.url));

export default tseslint.config(
  {
    // Global ignores (own object, no sibling keys — flat-config requirement).
    // Agent infrastructure and build output are not project code and are not
    // covered by tsconfig.json's `include`, so type-aware linting can't parse
    // them anyway.
    ignores: [".agents/**", "node_modules/**", "dist/**", "_site/**"],
  },
  ...tseslint.configs.strictTypeChecked,
  ...tseslint.configs.stylisticTypeChecked,
  // Blocking security lint (#729) — parity with ruff's `S` (bandit) rules, which
  // Python runs on every `just lint`. Before this, TS's only SAST was the
  // non-blocking semgrep CI job, so a repo could merge with OWASP-class findings
  // and nothing caught them. `security.configs.recommended` ships its rules at
  // WARNING, which eslint exits 0 on — the severities are pinned to error below,
  // or this would be a gate that never blocks.
  security.configs.recommended,
  noUnsanitized.configs.recommended,
  // Enforced JSDoc on exported/public symbols (TypeScript-aware preset).
  jsdoc.configs["flat/recommended-typescript"],
  {
    // Type-aware linting (PI-570): strictTypeChecked/stylisticTypeChecked catch
    // bugs `strict` alone misses — a floating `Promise` in an async function
    // (no-floating-promises/require-await) and unsafe `any` propagation through
    // a return value (no-unsafe-return/no-unsafe-member-access).
    //
    // Scope every type-aware setting to *.ts(x) — the only files tsconfig.json
    // includes (PI-560). Without this `files` guard eslint points the type
    // parser at this .mjs config (which is outside the project) and at an empty
    // project before the first .ts source exists (TS18003) — either of which
    // fails the whole lint run on a fresh scaffold. That day-one break is what
    // let the fail-closed pre-commit gate block every commit before any code
    // was written.
    files: ["**/*.ts", "**/*.tsx"],
    languageOptions: {
      parserOptions: {
        project: "./tsconfig.json",
        tsconfigRootDir: __dirname,
      },
    },
    plugins: { tsdoc },
    rules: {
      // --- security gates (#729) -------------------------------------------
      // Pinned to `error`: eslint-plugin-security's recommended preset sets
      // these to `warn`, and eslint exits 0 on warnings — a non-blocking
      // "gate". Verified: eval(userInput) and `el.innerHTML = dirty` both exit 1.
      "security/detect-eval-with-expression": "error",
      "security/detect-child-process": "error",
      "security/detect-non-literal-fs-filename": "error",
      "security/detect-unsafe-regex": "error",
      "no-unsanitized/method": "error",
      "no-unsanitized/property": "error",
      // Pinned, not inherited (#729). These come from strictTypeChecked today,
      // so a preset change upstream could silently downgrade them. Python's
      // `select = [..., "S"]` is explicit; make these explicit too.
      "@typescript-eslint/no-floating-promises": "error",
      "@typescript-eslint/no-misused-promises": "error",
      "@typescript-eslint/no-unsafe-assignment": "error",
      "@typescript-eslint/no-unsafe-call": "error",
      "@typescript-eslint/no-unsafe-member-access": "error",
      "@typescript-eslint/no-unsafe-return": "error",
      "@typescript-eslint/no-unsafe-argument": "error",
      // ----------------------------------------------------------------------
      // Mechanical guards against noodly generated code — mirror the
      // thresholds the Python preset uses in ruff.toml.
      complexity: ["error", 10],
      "max-params": ["error", 5],
      "max-depth": ["error", 4],
      "tsdoc/syntax": "warn",
      // Public-API docstrings at error level — parity with ruff's `D` gate
      // (Python) and revive's `exported` (Go), which both block. `publicOnly`
      // limits enforcement to exported symbols, so internal helpers stay
      // undocumented without failing the build.
      "jsdoc/require-jsdoc": [
        "error",
        {
          publicOnly: true,
          require: {
            FunctionDeclaration: true,
            MethodDefinition: true,
            ClassDeclaration: true,
          },
          contexts: [
            "TSInterfaceDeclaration",
            "TSTypeAliasDeclaration",
            "TSEnumDeclaration",
          ],
        },
      ],
    },
  },
  {
    // This eslint config and any other .mjs/.cjs/.js tooling files live outside
    // tsconfig's `include`, so the type-checked rules can't run on them. Turn
    // those rules off here (rather than ignoring the files) so they still get
    // baseline linting without a parser error.
    files: ["**/*.mjs", "**/*.cjs", "**/*.js"],
    extends: [tseslint.configs.disableTypeChecked],
  },
);
{{/if node}}
