# justfile — the canonical command interface (scaffolded by project-init).
# `just --list` shows every recipe. Recipes are thin wrappers — logic lives
# in the tools and their configs, never in this file.

# fetch dependencies
setup:
    sh -c 'if [ -f Cargo.toml ]; then cargo fetch; else echo "No Cargo project yet — run cargo init."; fi'

# build the project. All cargo recipes skip cleanly before `cargo init` — cargo
# errors without a Cargo.toml, so a fresh scaffold's `just ci` / `just fast-ci`
# would fail day-one without these guards (parity with the go/node day-one skips).
[doc("build the project")]
build:
    sh -c 'if [ -f Cargo.toml ]; then cargo build; else echo "No Cargo project yet — run cargo init."; fi'

# lint project code (clippy pedantic + cognitive-complexity + public-API docs).
# -D clippy::cognitive_complexity activates the threshold in clippy.toml — it's
# a nursery lint that -D pedantic does NOT enable, so without this flag the
# clippy.toml threshold is dead config. -D missing_docs enforces docs on public
# items (parity with ruff's D gate and revive's `exported`); for a binary crate
# with no pub items it only asks for a crate-level `//!` doc.
[doc("lint project code (clippy pedantic + cognitive-complexity + public-API docs).")]
lint:
    # Two passes, because -D missing_docs and --all-targets do not mix (#725).
    # 1. Public API: docs enforced on lib/bin only. Applied to --all-targets it
    #    demands a crate-level `//!` in every integration test file — verified.
    sh -c 'if [ -f Cargo.toml ]; then cargo clippy --all-features -- -D warnings -D clippy::pedantic -D clippy::cognitive_complexity -D missing_docs; else echo "No Cargo project yet — run cargo init."; fi'
    # 2. Everything else: without --all-targets clippy never sees tests/, benches/
    #    or examples/, so a test module with an outright TYPE ERROR passed
    #    `just lint` with exit 0. --all-features also reaches code behind a
    #    non-default feature flag. Verified against clippy 0.1.97.
    sh -c 'if [ -f Cargo.toml ]; then cargo clippy --all-targets --all-features -- -D warnings -D clippy::pedantic -D clippy::cognitive_complexity; else echo "No Cargo project yet — run cargo init."; fi'
    sh -c 'if [ -f Cargo.toml ]; then cargo fmt --check; else echo "No Cargo project yet — run cargo init."; fi'
    sh -c 'if command -v shellcheck >/dev/null 2>&1; then find .agents -name "*.sh" -exec shellcheck -S error -x {} +; else echo "shellcheck not installed — skipping shell lint (CI still runs it). Install: https://github.com/koalaman/shellcheck#installing or run \`mise install\`."; fi'
    sh -c 'if command -v shfmt >/dev/null 2>&1; then find .agents -name "*.sh" -exec shfmt -d -i 2 {} +; else echo "shfmt not installed — skipping shfmt check (CI still runs it). Install: https://github.com/mvdan/sh#shfmt or run \`mise install\`."; fi'
    bash .agents/scripts/lint-context-budget.sh
    just naming
    just docs-check

# type-only compile pass. Redundant with `just lint` by design: clippy already
# type-checks, but `just typecheck` must mean the same thing in every language,
# because that is what CI and agents call (#725). `cargo check` skips codegen,
# so it is fast.
[doc("type-only compile pass")]
typecheck:
    sh -c 'if [ -f Cargo.toml ]; then cargo check --all-targets --all-features; else echo "No Cargo project yet — run cargo init."; fi'

# auto-format project code
format:
    sh -c 'if [ -f Cargo.toml ]; then cargo fmt; else echo "No Cargo project yet — run cargo init."; fi'

# run the test suite; ends with the test contract's `<project>: N passed, M failed`
# line and cargo's own exit code (#1054).
[doc("run the test suite")]
test:
    sh -c 'if [ -f Cargo.toml ]; then bash .agents/hooks/python-resolve.sh .agents/scripts/contract-line.py {{project_slug}} cargo -- cargo test; else echo "No Cargo project yet — run cargo init."; echo "{{project_slug}}: 0 passed, 0 failed"; fi'

# quiet run for the edit-test loop (token-efficiency; PI-641; cargo has no
# stable fail-fast flag, so quiet output is the lever here)
[doc("quiet run for the edit-test loop")]
test-quick:
    sh -c 'if [ -f Cargo.toml ]; then cargo test -q; else echo "No Cargo project yet — run cargo init."; fi'

# tests with the coverage gate (CI always runs this, not `test` — PI-569).
# requires cargo-llvm-cov: `cargo install cargo-llvm-cov` + `rustup component
# add llvm-tools-preview`, once, on your machine (CI installs it per-run).
# tune the "70" threshold to your project's baseline.
[doc("tests with the coverage gate (CI always runs this, not `test` — PI-569).")]
test-cov:
    sh -c 'if [ -f Cargo.toml ]; then cargo llvm-cov --fail-under-lines 70; else echo "No Cargo project yet — run cargo init."; fi'

# docs: nothing to build locally — docs.rs renders published crate docs
docs:
    @echo "docs.rs renders published crate docs — nothing to build locally"

# dependency vulnerability scan against known CVEs/advisories (PI-568).
# requires cargo-audit: `cargo install cargo-audit` once, on your machine
# (CI installs it per-run as a prebuilt binary).
[doc("dependency vulnerability scan against known CVEs/advisories (PI-568).")]
audit:
    sh -c 'if [ -f Cargo.toml ]; then cargo audit; else echo "No Cargo project yet — run cargo init."; fi'

# generate a CycloneDX SBOM of the crate dependency tree (#574). release.yml
# attaches this (<crate>.cdx.json) to GitHub Releases.
# requires cargo-cyclonedx: cargo install cargo-cyclonedx
[doc("generate a CycloneDX SBOM of the crate dependency tree (#574)")]
sbom:
    sh -c 'if [ -f Cargo.toml ]; then cargo cyclonedx --format json --spec-version 1.5; else echo "No Cargo project yet — run cargo init."; fi'

# dependency license compliance scan (#579) — cargo-deny checks licenses against
# deny.toml (deny GPL/AGPL by default; everything else allowed). cargo-deny can
# ALSO check advisories, subsuming `cargo audit` (#568); we keep `cargo audit`
# as the dedicated CVE gate for now — run `cargo deny check` (all) to consolidate.
# requires cargo-deny: cargo install cargo-deny
[doc("dependency license compliance scan (#579)")]
license:
    sh -c 'if [ -f Cargo.toml ]; then cargo deny check licenses; else echo "No Cargo project yet — run cargo init."; fi'

# property-based tests with proptest (#580). Add the dep once: cargo add --dev
# proptest. Property tests are opt-in per file (proptest! macro) and run under
# `cargo test`. Pattern/tooling, NOT a blocking gate: CI runs this in the nightly
# `fuzz` job, never on a PR (#727). proptest draws fresh seeds each run, so the
# nightly job explores inputs a per-PR run would only repeat.
[doc("property-based tests with proptest (#580)")]
fuzz:
    sh -c 'if [ -f Cargo.toml ]; then cargo test; else echo "No Cargo project yet — run cargo init."; fi'

# scan staged changes for secrets (same scan as the pre-commit git hook)
scan:
    gitleaks git --pre-commit --staged --redact --no-banner --verbose

# the naming standard over this repo, as a ratchet: new findings fail, a fixed
# finding must be deleted from gates/naming.baseline. Judges with the vendored package in
# vendor/naming/ (no checkout of the standard needed); UNCHECKED exits 3, never a pass. Guarded so
# an upgrade that declined the `naming-gate` addition group keeps a working `just lint`.
[doc("naming standard ratchet (gates/naming-check.sh)")]
naming:
    sh -c 'if [ -f gates/naming-check.sh ]; then sh gates/naming-check.sh; else echo "naming gate not installed here (project-init upgrade --apply --accept-new naming-gate)"; fi'

# docs front matter and generated-file headers (kind, owner, status; generated-by equals contracts/fresh-checks.tsv).
# Born warn: findings print and exit 0; `sh gates/doc-check.sh --strict` makes them red. Guarded like `naming`.
[doc("docs front matter + generated headers (gates/doc-check.sh)")]
docs-check:
    sh -c 'if [ -f gates/doc-check.sh ]; then sh gates/doc-check.sh; else echo "doc gate not installed here (project-init upgrade --apply --accept-new naming-gate)"; fi'

# what CI runs (the full gate)
ci: lint typecheck test-cov audit

# fast local gate for the pre-push hook: lint + parallel tests (CI is the full
# backstop, so pre-push stays fast and doesn't re-run typecheck/coverage/audit)
[doc("fast local gate for the pre-push hook")]
fast-ci: lint test

# route CI to a self-hosted runner when Actions minutes run out (PI-666);
# requires a registered runner — see .agents/docs/guides/self-hosted-ci-runner.md
[doc("route CI to a self-hosted runner when Actions minutes run out (PI-666)")]
ci-local-on:
    gh variable set CI_RUNS_ON --body self-hosted

# back to GitHub-hosted runners
ci-local-off:
    gh variable delete CI_RUNS_ON
